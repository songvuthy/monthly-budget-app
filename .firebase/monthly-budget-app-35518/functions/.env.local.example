# Copy this file to .env.local and fill in real values from your Firebase
# service account. Never commit .env.local — it holds a private key.
#
# How to get these values:
# 1. Go to console.firebase.google.com and create a project (or use an existing one).
# 2. Build > Firestore Database > Create database (production mode is fine —
#    the app only talks to Firestore from the server, never the browser, so
#    the default "deny all" security rules are exactly what you want).
# 3. Project settings (gear icon) > Service accounts > Generate new private key.
#    This downloads a JSON file with the three values below.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Paste the "private_key" value from the downloaded JSON exactly as-is,
# including the quotes and the literal \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
